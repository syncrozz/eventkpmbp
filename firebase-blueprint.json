{
  "entities": {
    "events": {
      "title": "Events",
      "description": "KPMBP College events, competitions, workshops and activities",
      "type": "object",
      "properties": {
        "eventType": { "type": "string", "description": "ONE_TIME_EVENT or ONGOING_PROGRAM" },
        "title": { "type": "string", "description": "Title of the event" },
        "description": { "type": "string", "description": "Full description of the event" },
        "category": { "type": "string", "description": "Category (Akademik, Sukan, Kebudayaan, Kepimpinan, Keusahawanan, Pertandingan, Kerjaya, Program Pelajar)" },
        "date": { "type": "string", "description": "Event date (YYYY-MM-DD)" },
        "startTime": { "type": "string", "description": "Start time string" },
        "endTime": { "type": "string", "description": "End time string" },
        "location": { "type": "string", "description": "Physical campus location" },
        "organiser": { "type": "string", "description": "Organiser name / club" },
        "image": { "type": "string", "description": "Event banner / poster image URL" },
        "eventMode": { "type": "string", "description": "physical or online" },
        "registrationMode": { "type": "string", "description": "admin, google_form, or none" },
        "organiserWhatsApp": { "type": "string", "description": "Organiser WhatsApp number for admin registrations" },
        "submissionDeadline": { "type": "string", "description": "Submission deadline for online events" },
        "registrationUrl": { "type": "string", "description": "Google form link" },
        "registrationDeadline": { "type": "string", "description": "Deadline for registration" },
        "status": { "type": "string", "description": "Registration Open, Registration Closing Soon, Registration Closed, Fully Booked, Upcoming, Ongoing, Completed, Cancelled, Archived" },
        "eligibility": { "type": "string", "description": "Eligibility conditions" },
        "contact": { "type": "string", "description": "Person in charge contact info" },
        "featured": { "type": "boolean", "description": "Whether event is highlighted" },
        "importantNotice": { "type": "string", "description": "Urgent alert or important notice" },
        "seatsLeft": { "type": "number", "description": "Number of remaining seats" },
        "totalSeats": { "type": "number", "description": "Total seat capacity" },
        "tags": { "type": "array", "items": { "type": "string" }, "description": "Search tags" },
        "programDuration": { "type": "string", "description": "Duration for ongoing program (e.g. Sepanjang Semester)" },
        "scheduleSummary": { "type": "string", "description": "Schedule summary (e.g. 4 kali seminggu)" },
        "scheduleSessions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "dayOfWeek": { "type": "string" },
              "startTime": { "type": "string" },
              "endTime": { "type": "string" },
              "sessionName": { "type": "string" },
              "location": { "type": "string" }
            }
          },
          "description": "Recurring sessions list for ongoing programs"
        },
        "feeType": { "type": "string", "description": "free, paid, voluntary" },
        "feeAmount": { "type": "string", "description": "Fee amount string" },
        "targetAudience": { "type": "string", "description": "Target audience / participants" },
        "maxCapacity": { "type": "number", "description": "Maximum capacity" },
        "createdAt": { "type": "string", "description": "Creation ISO timestamp" },
        "updatedAt": { "type": "string", "description": "Update ISO timestamp" }
      },
      "required": ["title", "description", "category", "organiser", "status"]
    },
    "registrations": {
      "title": "Registrations",
      "description": "Student event registration records",
      "type": "object",
      "properties": {
        "eventId": { "type": "string", "description": "ID of the event registered for" },
        "eventTitle": { "type": "string", "description": "Title of the event" },
        "studentName": { "type": "string", "description": "Full name of student" },
        "studentId": { "type": "string", "description": "Student ID / Matrix number" },
        "email": { "type": "string", "description": "Student email address" },
        "phone": { "type": "string", "description": "WhatsApp contact number" },
        "programCode": { "type": "string", "description": "Academic program code" },
        "timestamp": { "type": "string", "description": "Registration timestamp" }
      },
      "required": ["eventId", "studentName", "studentId", "email", "phone", "programCode"]
    },
    "settings": {
      "title": "Settings",
      "description": "Application settings including Hero Carousel configuration",
      "type": "object",
      "properties": {
        "autoPlay": { "type": "boolean", "description": "Whether hero auto rotates" },
        "intervalSeconds": { "type": "number", "description": "Slide interval in seconds" },
        "slides": { "type": "array", "description": "Hero carousel slides array" },
        "updatedAt": { "type": "string", "description": "Last update timestamp" }
      }
    },
    "eventSubmissions": {
      "title": "EventSubmissions",
      "description": "Public organizer event submissions pending admin review",
      "type": "object",
      "properties": {
        "status": { "type": "string", "description": "PENDING, APPROVED, REJECTED" },
        "submittedAt": { "type": "string", "description": "Submission ISO timestamp" },
        "reviewedAt": { "type": "string", "description": "Review ISO timestamp" },
        "reviewedBy": { "type": "string", "description": "Reviewer identity" },
        "rejectionReason": { "type": "string", "description": "Reason for rejection if rejected" },
        "approvedEventId": { "type": "string", "description": "ID of published event" },
        "submitterName": { "type": "string", "description": "Name of organizer representative" },
        "submitterPhone": { "type": "string", "description": "Phone number of organizer" },
        "submitterEmail": { "type": "string", "description": "Email of organizer" },
        "submitterRole": { "type": "string", "description": "Role of submitter" },
        "eventType": { "type": "string", "description": "ONE_TIME_EVENT or ONGOING_PROGRAM" },
        "title": { "type": "string", "description": "Title of the proposed event" },
        "description": { "type": "string", "description": "Full description of event" },
        "category": { "type": "string", "description": "Category of event" },
        "date": { "type": "string", "description": "Event date" },
        "startTime": { "type": "string", "description": "Start time" },
        "endTime": { "type": "string", "description": "End time" },
        "location": { "type": "string", "description": "Campus location" },
        "organiser": { "type": "string", "description": "Organising body or club" },
        "image": { "type": "string", "description": "Poster / banner image" },
        "eventMode": { "type": "string", "description": "physical or online" },
        "registrationMode": { "type": "string", "description": "none, admin, or google_form" },
        "organiserWhatsApp": { "type": "string", "description": "WhatsApp contact" },
        "organiserUrl": { "type": "string", "description": "Official reference URL" },
        "submissionDeadline": { "type": "string", "description": "Submission deadline" },
        "registrationUrl": { "type": "string", "description": "Registration URL" },
        "registrationDeadline": { "type": "string", "description": "Registration deadline" },
        "eligibility": { "type": "string", "description": "Eligibility conditions" },
        "contact": { "type": "string", "description": "Contact info" },
        "importantNotice": { "type": "string", "description": "Notice text" },
        "seatsLeft": { "type": "number", "description": "Seats left" },
        "totalSeats": { "type": "number", "description": "Total seats" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "scheduleSummary": { "type": "string" },
        "scheduleSessions": { "type": "array" },
        "programDuration": { "type": "string" },
        "feeType": { "type": "string" },
        "feeAmount": { "type": "string" },
        "targetAudience": { "type": "string" }
      },
      "required": ["title", "description", "category", "organiser", "submitterName", "submitterPhone", "status"]
    }
  },
  "firestore": {
    "/events/{eventId}": {
      "schema": "events",
      "description": "Public events collection"
    },
    "/eventSubmissions/{submissionId}": {
      "schema": "eventSubmissions",
      "description": "Organizer event submission proposals"
    },
    "/registrations/{registrationId}": {
      "schema": "registrations",
      "description": "Event registrations submitted by students"
    },
    "/settings/{settingId}": {
      "schema": "settings",
      "description": "Application settings including Hero Carousel configuration"
    }
  }
}
